<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DevConsole</AssemblyName>
    <RootNamespace>DevConsole</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Unity player assemblies are built against mscorlib 4.x; the game runs the .NET Framework compat level. -->
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\ENDLESS Legend 2</GameDir>
    <Managed>$(GameDir)\Endless Legend 2_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="Amplitude" HintPath="$(Managed)\Amplitude.dll" Private="false" />
    <Reference Include="Amplitude.Framework" HintPath="$(Managed)\Amplitude.Framework.dll" Private="false" />
    <Reference Include="Amplitude.Mercury.Data" HintPath="$(Managed)\Amplitude.Mercury.Data.dll" Private="false" />
    <!-- Definitions derive from Odin's SerializedScriptableObject; naming one makes the compiler walk that chain. -->
    <Reference Include="Sirenix.Serialization" HintPath="$(Managed)\Sirenix.Serialization.dll" Private="false" />
    <!-- The order DTOs and SandboxManager.PostOrder are public here; the simulation entities are not. -->
    <Reference Include="Amplitude.Mercury.Firstpass" HintPath="$(Managed)\Amplitude.Mercury.Firstpass.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Amplitude.UI" HintPath="$(Managed)\Amplitude.UI.dll" Private="false" />
    <Reference Include="Amplitude.DebugOverlay" HintPath="$(Managed)\Amplitude.DebugOverlay.dll" Private="false" />
  </ItemGroup>

</Project>
